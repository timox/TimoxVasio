; Timox virtual Windows audio, prototype N1. Derived from SysVAD INF conventions.
; No APO, keyword adapter, sideband device, DRM signature or default-device change.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=10/22/2026,0.1.0.0
CatalogFile=TimoxWindowsAudio.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Timox,NT$ARCH$.10.0...22621
[Timox.NT$ARCH$.10.0...22621]
%DeviceName%=TimoxAudio,Root\TimoxWindowsAudio
[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
TimoxWindowsAudio.sys=1
[DestinationDirs]
DriverCopy=13
[DriverCopy]
TimoxWindowsAudio.sys

[TimoxAudio.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=DriverCopy
AddReg=DriverRegistry
[DriverRegistry]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,TimoxWindowsAudio.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceName%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceName%

[TimoxAudio.NT.Interfaces]
AddInterface=%Audio%,TimoxRenderWave,RenderWave
AddInterface=%Render%,TimoxRenderWave,RenderWave
AddInterface=%Realtime%,TimoxRenderWave,RenderWave
AddInterface=%Audio%,TimoxRenderTopology,RenderTopology
AddInterface=%Topology%,TimoxRenderTopology,RenderTopology
AddInterface=%Audio%,TimoxCaptureWave,CaptureWave
AddInterface=%Capture%,TimoxCaptureWave,CaptureWave
AddInterface=%Realtime%,TimoxCaptureWave,CaptureWave
AddInterface=%Audio%,TimoxCaptureTopology,CaptureTopology
AddInterface=%Topology%,TimoxCaptureTopology,CaptureTopology
[RenderWave]
AddReg=RenderWaveRegistry
[RenderWaveRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
[RenderTopology]
AddReg=RenderTopologyRegistry
[RenderTopologyRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%RenderName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1
[CaptureWave]
AddReg=CaptureWaveRegistry
[CaptureWaveRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
[CaptureTopology]
AddReg=CaptureTopologyRegistry
[CaptureTopologyRegistry]
HKR,,CLSID,,%Proxy%
HKR,,FriendlyName,,%CaptureName%
HKR,EP\0,%Association%,,%AnyNode%
HKR,EP\0,%EventDriven%,0x00010001,1

[TimoxAudio.NT.Services]
AddService=TimoxWindowsAudio,0x00000002,DriverService
[DriverService]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\TimoxWindowsAudio.sys
[TimoxAudio.NT.HW]
AddReg=DeviceRegistry
[DeviceRegistry]
HKR,,DeviceType,0x00010001,0x1D
; Standard audio device access. The future private control interface requires a separate restrictive ACL.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"
[TimoxAudio.NT.Wdf]
KmdfService=TimoxWindowsAudio,WdfSettings
[WdfSettings]
KmdfLibraryVersion=$KMDFVERSION$

[Strings]
Provider="Timox"
DeviceName="Timox Windows Audio (prototype)"
DiskName="Timox Windows Audio driver"
RenderName="Timox Windows Input"
CaptureName="Timox Windows Output"
Proxy="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
Audio="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
Render="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
Capture="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
Realtime="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
Topology="{DDA54A40-1E4C-11D1-A050-405705C10000}"
AnyNode="{00000000-0000-0000-0000-000000000000}"
Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
EventDriven="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
