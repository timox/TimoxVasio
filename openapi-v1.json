{
  "openapi": "3.1.0",
  "info": {
    "title": "TimoxVasio Local Control API",
    "version": "1.0.0",
    "description": "Control contract for the local TimoxVasio audio engine. The API binds only to 127.0.0.1. HTTP exposes confirmed engine state and driver inventory; the WebSocket starts and stops audio, applies configuration, measures active-channel levels and stereo correlation, and publishes diagnostics. Audio samples stay on the ASIO/shared-memory path and are never sent through this control API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:{port}",
      "description": "Loopback only. The engine reports its selected port at startup.",
      "variables": { "port": { "default": "52525", "description": "Local engine port" } }
    }
  ],
  "paths": {
    "/api/v1/state": {
      "get": {
        "operationId": "getEngineState",
        "summary": "Read the confirmed engine state and complete routing configuration",
        "responses": {
          "200": {
            "description": "Current engine state, inventory and routes",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/State" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/drivers": {
      "get": {
        "operationId": "getDriverInventory",
        "summary": "Read physical ASIO and TimoxVasio driver capabilities",
        "responses": {
          "200": {
            "description": "Discovered driver inventory",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Drivers" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/application-profiles": {
      "get": {
        "operationId": "getApplicationProfiles",
        "summary": "Read per-application ASIO channel compatibility profiles",
        "description": "Unlisted processes receive 256 input and output channels. The built-in Mixxx profile advertises 255 in both directions. Profiles match the executable basename case-insensitively. A running client must be restarted after its effective profile changes.",
        "responses": {
          "200": {
            "description": "Current application profiles",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationProfiles" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      },
      "put": {
        "operationId": "replaceApplicationProfiles",
        "summary": "Replace all per-application ASIO channel profiles",
        "description": "Replaces the complete profile list. An empty list restores the 256-channel default for every application. Existing clients whose effective channel counts changed are returned in restartRequiredClients; their current ASIO instances retain their original getChannels result until restarted.",
        "requestBody": {
          "required": true,
          "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ReplaceApplicationProfiles" } } }
        },
        "responses": {
          "200": {
            "description": "Profiles saved and clients requiring restart identified",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApplicationProfilesUpdate" } } }
          },
          "400": {
            "description": "Invalid profile list",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Error" } } }
          },
          "500": { "$ref": "#/components/responses/ServerError" }
        }
      }
    },
    "/api/v1/diagnostics": {
      "get": {
        "operationId": "getDiagnostics",
        "summary": "Read recent engine log entries and the active log level",
        "parameters": [{"name": "limit", "in": "query", "required": false, "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 200}}],
        "responses": {
          "200": {"description": "Recent persistent engine log entries", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Diagnostics"}}}},
          "400": {"description": "Invalid entry limit", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "500": {"$ref": "#/components/responses/ServerError"}
        }
      },
      "put": {
        "operationId": "setDiagnosticLevel",
        "summary": "Persist the engine log level",
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticLevel"}}}},
        "responses": {
          "200": {"description": "Confirmed active level", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DiagnosticLevel"}}}},
          "400": {"description": "Invalid level", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "500": {"$ref": "#/components/responses/ServerError"}
        }
      }
    },
    "/api/v1/openapi.json": {
      "get": { "operationId": "getOpenApiDocument", "summary": "Read the OpenAPI document served by the engine", "responses": { "200": { "description": "OpenAPI 3.1 document", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/api/v1/schemas/api-v1.json": {
      "get": { "operationId": "getApiJsonSchema", "summary": "Read the normative JSON schema", "responses": { "200": { "description": "JSON Schema document", "content": { "application/json": { "schema": { "type": "object" } } } } } }
    },
    "/api/v1/ws": {
      "get": {
        "operationId": "controlEngineWebSocket",
        "summary": "Upgrade to the TimoxVasio control WebSocket",
        "description": "Connect with the vasio.api.v1 subprotocol. engine.start and engine.stop control audio while leaving the local API available; stopping is refused while a TimoxVasio ASIO client is attached. audio.meter events are sent only for routed endpoints at approximately two updates per second. audio.correlation reports a rolling wide-band L/R correlation for one active routed stereo pair. Audio sample transport remains on the ASIO/shared-memory path. See x-websocket for message schemas.",
        "responses": { "101": { "description": "WebSocket protocol upgrade" } },
        "x-websocket": {
          "subprotocol": "vasio.api.v1",
          "clientMessages": { "$ref": "#/components/schemas/ClientCommand" },
          "serverMessages": {
            "oneOf": [
              { "$ref": "#/components/schemas/Response" },
              { "$ref": "#/components/schemas/Event" }
            ]
          },
          "commands": ["engine.start", "engine.stop", "configuration.apply", "audio.correlation.start", "audio.correlation.stop"],
          "events": ["engine.status", "devices.changed", "routes.changed", "audio.meter", "audio.stereoPairs.changed", "audio.correlation", "engine.error"]
        }
      }
    }
  },
  "components": {
    "schemas": {
      "State": { "$ref": "./schemas/api-v1.json#/definitions/state" },
      "Drivers": { "$ref": "./schemas/api-v1.json#/definitions/drivers" },
      "StereoPair": { "$ref": "./schemas/api-v1.json#/definitions/stereoPair" },
      "ApplicationProfiles": { "$ref": "./schemas/api-v1.json#/definitions/applicationProfiles" },
      "ReplaceApplicationProfiles": { "$ref": "./schemas/api-v1.json#/definitions/replaceApplicationProfiles" },
      "ApplicationProfilesUpdate": { "$ref": "./schemas/api-v1.json#/definitions/applicationProfilesUpdate" },
      "Diagnostics": { "$ref": "./schemas/api-v1.json#/definitions/diagnostics" },
      "DiagnosticLevel": { "$ref": "./schemas/api-v1.json#/definitions/diagnosticLevel" },
      "ApplyCommand": { "$ref": "./schemas/api-v1.json#/definitions/applyCommand" },
      "ClientCommand": { "$ref": "./schemas/api-v1.json#/definitions/clientCommand" },
      "EngineStartCommand": { "$ref": "./schemas/api-v1.json#/definitions/engineStartCommand" },
      "EngineStopCommand": { "$ref": "./schemas/api-v1.json#/definitions/engineStopCommand" },
      "CorrelationStartCommand": { "$ref": "./schemas/api-v1.json#/definitions/correlationStartCommand" },
      "CorrelationStopCommand": { "$ref": "./schemas/api-v1.json#/definitions/correlationStopCommand" },
      "Response": { "$ref": "./schemas/api-v1.json#/definitions/response" },
      "Event": { "$ref": "./schemas/api-v1.json#/definitions/event" },
      "Error": { "$ref": "./schemas/api-v1.json#/definitions/error" }
    },
    "responses": {
      "ServerError": {
        "description": "The local engine could not serve the request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/Error" }
          }
        }
      }
    }
  }
}
