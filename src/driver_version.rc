#include <windows.h>
#include "driver_version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION TIMOX_FILE_VERSION
 PRODUCTVERSION TIMOX_FILE_VERSION
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "TimoxVasio ASIO Driver\0"
            VALUE "FileVersion", TIMOX_FILE_VERSION_STRING
            VALUE "OriginalFilename", "TimoxVasio.dll\0"
            VALUE "ProductName", "TimoxVasio\0"
            VALUE "ProductVersion", TIMOX_PRODUCT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
